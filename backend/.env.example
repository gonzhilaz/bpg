# App Configurations
APP_ENV=development
SERVER_PORT=8080
MASTER_SECRET_KEY=change-this-to-a-secure-32-byte-hex-or-passphrase-in-production

# Database (options: "sqlite" or "postgres")
DB_DRIVER=sqlite
DATABASE_URL=data/13c.db
# For PostgreSQL:
# DB_DRIVER=postgres
# DATABASE_URL=host=localhost user=postgres password=postgres dbname=13c_gateway port=5432 sslmode=disable

# Invoicing & Settlement Rules
INVOICE_EXPIRY_MINUTES=30
INVOICE_GRACE_PERIOD_MINUTES=15
UNDERPAID_TOLERANCE_PERCENT=0.0

# Blockchain RPC Providers
BSC_RPC_URL=https://bsc-dataseed.binance.org/
POLYGON_RPC_URL=https://polygon-rpc.com/
TRON_GRID_URL=https://api.trongrid.io
TRON_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

