{
  "openapi": "3.0.3",
  "info": {
    "title": "13CPG Merchant Payment API",
    "description": "Public REST API for 13CPG Merchant Payment Processing. Authenticate requests using your unique API Key via the 'X-API-KEY' HTTP header.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Active API Gateway"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Gateway Health Check",
        "description": "Returns operational status of the gateway services.",
        "responses": {
          "200": {
            "description": "Gateway operational",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "healthy" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices": {
      "post": {
        "summary": "Create Payment Invoice",
        "description": "Generates a dedicated payment deposit address and calculates exact payable amount.",
        "security": [
          { "ApiKeyAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invoice created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized: Invalid or missing X-API-KEY header" },
          "400": { "description": "Bad Request: Missing or invalid parameters" }
        }
      }
    },
    "/api/v1/invoices/{id}": {
      "get": {
        "summary": "Get Invoice Status",
        "description": "Retrieves current payment status and confirmation progress for a given invoice ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique UUID of the invoice",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice payment details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "404": { "description": "Invoice not found" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "Provide your secret merchant API key issued in Merchant Portal"
      }
    },
    "schemas": {
      "CreateInvoiceRequest": {
        "type": "object",
        "required": ["order_id", "amount", "currency", "pay_currency", "pay_network"],
        "properties": {
          "order_id": { "type": "string", "example": "ORD-10021" },
          "amount": { "type": "string", "example": "50.00" },
          "currency": { "type": "string", "example": "USD" },
          "pay_currency": { "type": "string", "example": "USDT" },
          "pay_network": {
            "type": "string",
            "enum": ["POLYGON", "BSC", "TRON", "SOLANA"],
            "example": "POLYGON"
          },
          "fee_payer": {
            "type": "string",
            "enum": ["customer", "merchant"],
            "default": "customer",
            "example": "customer"
          },
          "callback_url": {
            "type": "string",
            "example": "https://yourdomain.com/api/webhooks/payment"
          }
        }
      },
      "InvoiceResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "order_id": { "type": "string", "example": "ORD-10021" },
          "amount": { "type": "string", "example": "50.00" },
          "currency": { "type": "string", "example": "USD" },
          "pay_currency": { "type": "string", "example": "USDT" },
          "pay_network": { "type": "string", "example": "POLYGON" },
          "pay_amount": { "type": "string", "example": "50.00" },
          "deposit_address": { "type": "string", "example": "0x71C8A3951F6b4d3E118bFE7c251d18ff2..." },
          "status": {
            "type": "string",
            "enum": ["pending", "paid", "expired"],
            "example": "pending"
          },
          "seconds_remaining": { "type": "integer", "example": 1800 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
